# Album Club ops config. install.sh copies this to ~/.config/album-club/album-club.env (chmod 600).
# Project URL (no /rest/v1/ suffix) and anon key: Supabase dashboard → Project Settings → Data API / API Keys.
# DATABASE_URL lives in the login keychain (service "album-club", account "DATABASE_URL").
SUPABASE_URL=
SUPABASE_ANON_KEY=
